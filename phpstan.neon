includes:
    - phpstan.joomla.php

parameters:
    level: max
    phpVersion:
        min: 80400
        max: 80599

    paths:
        - bin/jxt
        - src
        - tests
        - plugin/src/Plan
        - phpstan.joomla.php
        - phpstan.joomla-root.php
        - phpstan.joomla-bootstrap.php

    excludePaths:
        - tests/tmp
